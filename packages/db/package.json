{
  "name": "@anar/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./tenant": {
      "types": "./dist/tenant.d.ts",
      "default": "./dist/tenant.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "test:integration": "vitest run",
    "migrate": "node dist/migrate.js",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.5"
  }
}
