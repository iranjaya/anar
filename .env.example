# PostgreSQL database name for local Compose.
POSTGRES_DB=
# PostgreSQL bootstrap user for local Compose.
POSTGRES_USER=
# PostgreSQL bootstrap password; fill this yourself.
POSTGRES_PASSWORD=
# Runtime database role password; fill this yourself.
APP_DATABASE_PASSWORD=
# Migration role password; fill this yourself.
MIGRATION_DATABASE_PASSWORD=
# API and worker URL using APP_DATABASE_PASSWORD; fill this yourself.
DATABASE_URL=
# Migration URL using MIGRATION_DATABASE_PASSWORD; fill this yourself.
MIGRATION_DATABASE_URL=
# Local LAN address on which Caddy listens; fill this yourself.
ANAR_LAN_BIND_ADDRESS=
# Stable local hostname used by Caddy; fill this yourself.
ANAR_SITE_ADDRESS=
# Exact HTTPS origin for browser auth; env:init fills this.
PUBLIC_ORIGIN=
# HTTPS cookies need false; leave empty for the default.
ANAR_LOCAL_HTTP=
# Trusted proxy CIDRs when needed; optional.
TRUSTED_PROXY_CIDRS=
# Email transport for the worker; env:init fills resend.
EMAIL_TRANSPORT=
# Sender address; env:init fills this.
EMAIL_FROM=
# Reply address; env:init fills this.
EMAIL_REPLY_TO=
# Resend key; env:init reads only the named Keychain item when empty.
RESEND_API_KEY=
# Stable 32-byte base64 mail encryption key; env:init generates this.
MAIL_ENCRYPTION_KEY=
# Stable 32-byte base64 OTP pepper; env:init generates this.
OTP_PEPPER=
# Push flag; env:init fills false until device setup is ready.
ANAR_PUSH_ENABLED=
# Uncompressed P-256 public key in base64url; env:init generates this.
VAPID_PUBLIC_KEY=
# P-256 private key in base64url; env:init generates this.
VAPID_PRIVATE_KEY=
# Push contact URI; env:init fills this.
VAPID_SUBJECT=
# Web auth feature flag; leave empty for the default true.
ANAR_AUTH_ENABLED=
# Optional local Mailpit URL for a non-Resend test stack.
MAILPIT_URL=
# Optional Mailpit browser port for the dev stack.
MAILPIT_HTTP_PORT=
