    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5",
    "zod": "4.6.7"
