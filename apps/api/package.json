{
  "name": "@anar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "default": "./dist/jobs/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "bootstrap:owner": "node dist/modules/auth/bootstrap.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anar/db": "workspace:*",
    "@anar/domain": "workspace:*",
    "@fastify/multipart": "10.1.3",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "libphonenumber-js": "1.13.15",
    "uuid": "14.0.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/web-push": "3.6.4",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
