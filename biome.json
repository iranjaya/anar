{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!!docs",
      "!!ANAR-System-Design.md",
      "!!next-env.d.ts",
      "!!pnpm-lock.yaml"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@/mock",
                  "@/mock/**",
                  "mock",
                  "mock/**",
                  "**/mock",
                  "**/mock/**"
                ],
                "message": "Only module data files may import mock data."
              },
              {
                "group": [
                  "@/modules/*/data",
                  "@/modules/*/data/**",
                  "@/modules/*/ui",
                  "@/modules/*/ui/**"
                ],
                "message": "Use the module's public entry files."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "modules/*/server.ts",
        "modules/*/components.ts",
        "modules/*/pages.ts"
      ],
      "assist": { "actions": { "source": { "organizeImports": "off" } } }
    },
    {
      "includes": ["modules/*/data/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/modules/*/data",
                      "@/modules/*/data/**",
                      "@/modules/*/ui",
                      "@/modules/*/ui/**"
                    ],
                    "message": "Use the module's public entry files."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["components/**", "lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/mock",
                      "@/mock/**",
                      "mock",
                      "mock/**",
                      "**/mock",
                      "**/mock/**",
                      "@/modules",
                      "@/modules/**"
                    ],
                    "message": "Shared code must not import modules or mock data."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
