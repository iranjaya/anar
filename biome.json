{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!!docs",
      "!!ANAR-System-Design.md",
      "!!apps/web/next-env.d.ts",
      "!!pnpm-lock.yaml",
      "!!packages/db/migrations/meta"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@/mock",
                  "@/mock/**",
                  "mock",
                  "mock/**",
                  "**/mock",
                  "**/mock/**"
                ],
                "message": "Only module data files may import mock data."
              },
              {
                "group": [
                  "@/modules/*/data",
                  "@/modules/*/data/**",
                  "@/modules/*/ui",
                  "@/modules/*/ui/**"
                ],
                "message": "Use the module's public entry files."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@anar/db",
                      "@anar/db/**",
                      "@anar/api",
                      "@anar/api/**",
                      "@anar/worker",
                      "@anar/worker/**",
                      "pg",
                      "pg/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "drizzle-kit",
                      "pg-boss",
                      "pg-boss/**"
                    ],
                    "message": "Web may only use domain public exports, never backend code."
                  },
                  {
                    "group": [
                      "@/mock",
                      "@/mock/**",
                      "mock",
                      "mock/**",
                      "**/mock",
                      "**/mock/**"
                    ],
                    "message": "Only module data files may import mock data."
                  },
                  {
                    "group": [
                      "@/modules/*/data",
                      "@/modules/*/data/**",
                      "@/modules/*/ui",
                      "@/modules/*/ui/**"
                    ],
                    "message": "Use the module's public entry files."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "@anar/db",
                      "@anar/db/**",
                      "@anar/web",
                      "@anar/web/**",
                      "@anar/api",
                      "@anar/api/**",
                      "@anar/worker",
                      "@anar/worker/**",
                      "server-only",
                      "next",
                      "next/**",
                      "react",
                      "react/**",
                      "pg",
                      "drizzle-orm",
                      "pg-boss"
                    ],
                    "message": "Domain must stay browser-safe and independent of apps and DB."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/modules/*/server.ts",
        "apps/web/modules/*/components.ts",
        "apps/web/modules/*/pages.ts"
      ],
      "assist": { "actions": { "source": { "organizeImports": "off" } } }
    },
    {
      "includes": ["apps/web/modules/*/data/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/modules/*/data",
                      "@/modules/*/data/**",
                      "@/modules/*/ui",
                      "@/modules/*/ui/**"
                    ],
                    "message": "Use the module's public entry files."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/components/**", "apps/web/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/mock",
                      "@/mock/**",
                      "mock",
                      "mock/**",
                      "**/mock",
                      "**/mock/**",
                      "@/modules",
                      "@/modules/**"
                    ],
                    "message": "Shared code must not import modules or mock data."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
